#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
#
# ddns-rs binary manager - used by the LuCI interface to install/update
# the ddns-rs binary (the package itself does not bundle it).
#
# Usage:
#   ddns-rs-binary status           - check if binary is installed
#   ddns-rs-binary install <url>    - download binary from a URL
#   ddns-rs-binary install-file <p> - install binary from a local file
#   ddns-rs-binary update           - self-update via ddns-rs -u
#   ddns-rs-binary version          - print current version
#   ddns-rs-binary path             - print binary path

BIN=/usr/bin/ddns-rs
TMP=/tmp/ddns-rs-binary.tmp

log() {
    logger -t ddns-rs "$1"
    echo "$1"
}

status() {
    if [ -x "$BIN" ]; then
        echo "installed"
    else
        echo "not-installed"
    fi
}

version() {
    if [ -x "$BIN" ]; then
        "$BIN" -v 2>/dev/null || echo "unknown"
    else
        echo "not-installed"
    fi
}

# Install from a local file (either a raw ELF binary or a tar.gz archive).
# Works with POSIX ash on OpenWrt (no bashisms).
install_file() {
    local src="$1"
    local extract_dir found
    [ -n "$src" ] && [ -f "$src" ] || { echo "file not found"; exit 1; }

    # Direct ELF binary? Check the 4-byte ELF magic with od (busybox-safe).
    if [ "$(head -c 4 "$src" 2>/dev/null | od -An -tx1 | tr -d ' \n')" = "7f454c46" ]; then
        mv -f "$src" "$BIN" || { echo "install failed"; exit 1; }
        chmod 755 "$BIN"
        log "ddns-rs installed: $("$BIN" -v)"
        return 0
    fi

    # Otherwise try to extract ddns-rs from a tar.gz archive.
    extract_dir="$(mktemp -d 2>/dev/null)"
    [ -n "$extract_dir" ] || extract_dir="/tmp/ddns-rs-extract.$$"
    mkdir -p "$extract_dir"
    if tar -xzf "$src" -C "$extract_dir" 2>/dev/null; then
        found="$(find "$extract_dir" -type f -name 'ddns-rs' 2>/dev/null | head -n 1)"
        if [ -n "$found" ]; then
            mv -f "$found" "$BIN" || { rm -rf "$extract_dir"; echo "install failed"; exit 1; }
            chmod 755 "$BIN"
            rm -rf "$extract_dir"
            log "ddns-rs installed: $("$BIN" -v)"
            return 0
        fi
    fi
    rm -rf "$extract_dir"
    echo "invalid binary or archive"
    exit 1
}

install_from_url() {
    local url="$1"
    [ -n "$url" ] || { echo "URL is empty"; exit 1; }

    log "Downloading ddns-rs from $url"
    curl -fL --retry 3 --connect-timeout 15 -o "$TMP" "$url" || {
        echo "download failed"
        rm -f "$TMP"
        exit 1
    }
    install_file "$TMP"
    rm -f "$TMP"
}

update() {
    if [ -x "$BIN" ]; then
        log "Running ddns-rs self-update"
        "$BIN" -u
    else
        log "ddns-rs not installed, downloading from default release"
        install_default
    fi
}

# Determine the Linux arch suffix used by ddns-rs release naming.
detect_arch() {
    case "$(uname -m)" in
        x86_64)   echo "x86_64" ;;
        aarch64)  echo "arm64" ;;
        armv7l|armv7) echo "armv7" ;;
        riscv64)  echo "riscv64" ;;
        *)        echo "" ;;
    esac
}

# Download the latest release binary from the default GitHub repo.
install_default() {
    local arch=$(detect_arch)
    [ -n "$arch" ] || { echo "unsupported architecture: $(uname -m)"; exit 1; }

    local repo="${DDNS_RS_REPO:-tagore-cai/ddns-rs}"

    # Prefer an explicit version set by the caller (e.g. from LuCI) to avoid
    # hitting the unauthenticated GitHub API rate limit (60 req/h per IP).
    local latest="${DDNS_RS_VERSION:-}"

    if [ -z "$latest" ]; then
        latest=$(curl -fsSL -A "ddns-rs-binary" \
            "https://api.github.com/repos/${repo}/releases/latest" 2>/dev/null \
            | grep -o '"tag_name":[^,]*' | head -1 | sed -E 's/.*"v?([^"]+)".*/\1/')
    fi

    [ -n "$latest" ] || {
        echo "cannot determine latest version; set DDNS_RS_VERSION or use 'install <url>'"
        exit 1
    }

    local url="https://github.com/${repo}/releases/download/v${latest}/ddns-rs_${latest}_linux_${arch}.tar.gz"
    log "Downloading ddns-rs ${latest} (${arch})"
    install_from_url "$url"
}

case "$1" in
    status)     status ;;
    version)    version ;;
    install)    install_from_url "$2" ;;
    install-file) install_file "$2" ;;
    update)     update ;;
    path)       echo "$BIN" ;;
    *)          echo "Usage: $0 {status|version|install <url>|install-file <path>|update|path}" ;;
esac
exit 0
