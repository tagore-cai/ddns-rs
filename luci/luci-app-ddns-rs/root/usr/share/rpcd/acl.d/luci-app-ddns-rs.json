{
	"luci-app-ddns-rs": {
		"description": "Grant access to the DDNS-RS LuCI app",
		"read": {
			"uci": [ "ddns-rs" ],
			"file": {
				"/etc/init.d/ddns-rs": [ "exec" ],
				"/usr/libexec/ddns-rs-call": [ "exec" ],
				"/bin/pidof": [ "exec" ],
				"/bin/ps": [ "exec" ],
				"/usr/bin/ddns-rs": [ "exec" ],
				"/etc/ddns-rs/ddns-rs-config.yaml": [ "read" ]
			},
			"ubus": {
				"luci.ddns-rs": [
					"status",
					"binary_progress",
					"get_ver"
				]
			}
		},
		"write": {
			"uci": [ "ddns-rs" ],
			"file": {
				"/etc/ddns-rs/ddns-rs-config.yaml": [ "write" ],
				"/usr/bin/ddns-rs": [ "write" ]
			},
			"ubus": {
				"luci.ddns-rs": [
					"binary_install",
					"binary_upload",
					"binary_update",
					"last_update"
				]
			}
		}
	}
}
